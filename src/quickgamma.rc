#include <windows.h>
#include "resource.h"
#pragma code_page(65001)
IDI_APP_ICON ICON "quickgamma.ico"
1 24 "quickgamma.manifest"
IDD_MAIN_DIALOG DIALOGEX 0, 0, 252, 119
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "QuickGamma"
FONT 9, "Yu Gothic UI"
BEGIN
    LTEXT "モニター", -1, 10, 11, 40, 10
    COMBOBOX IDC_COMBO_MONITOR, 52, 8, 190, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "ガンマ", -1, 10, 34, 40, 10
    CONTROL "", IDC_SLIDER_GAMMA, "msctls_trackbar32", TBS_NOTICKS | WS_TABSTOP, 52, 32, 144, 16
    EDITTEXT IDC_LABEL_VALUE, 201, 31, 41, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "全画面を 1.00 に戻す", IDC_BTN_DEFAULT, 10, 60, 90, 16
    PUSHBUTTON "ショートカットを作成", IDC_BTN_SHORTCUT, 105, 60, 95, 16
    DEFPUSHBUTTON "OK", IDOK, 137, 94, 48, 16
    PUSHBUTTON "キャンセル", IDCANCEL, 190, 94, 52, 16
END
